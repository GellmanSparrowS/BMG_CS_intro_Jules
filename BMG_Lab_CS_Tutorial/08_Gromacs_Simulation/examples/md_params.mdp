; Gromacs MDP file for a single SPC/E water molecule simulation
; Created by BMG Lab Tutorial Agent

; Preprocessing - 预处理
; define          = -DPOSRES  ; Use if position restraints are defined in the topology for equilibration
                              ; 如果在拓扑文件中为平衡定义了位置限制，则使用此选项

; Run Control - 运行控制
integrator      = md        ; Leap-frog integrator for molecular dynamics - 用于分子动力学的蛙跳积分器
dt              = 0.001     ; ps ! (1 fs) - 时间步长 (1飞秒)
nsteps          = 10000     ; Simulate for 10000 steps (10 ps total) - 模拟10000步 (总共10皮秒)

; Output Control - 输出控制
nstxout-compressed  = 1000    ; Save compressed coordinates every 1 ps (1000 steps) - 每1皮秒(1000步)保存一次压缩坐标到 .xtc
nstvout             = 0       ; Do not save velocities (not typically needed for basic analysis) - 不保存速度 (基本分析通常不需要)
nstfout             = 0       ; Do not save forces (not typically needed for basic analysis) - 不保存力 (基本分析通常不需要)
nstenergy           = 1000    ; Save energies to .edr file every 1 ps - 每1皮秒将能量保存到 .edr 文件
nstlog              = 1000    ; Update log file every 1 ps - 每1皮秒更新一次日志文件

; Neighbor searching and non-bonded interactions - 近邻搜索和非键相互作用
cutoff-scheme   = Verlet    ; Use Verlet scheme for neighbor searching - 使用Verlet方案进行近邻搜索
ns_type         = grid      ; Use a grid for neighbor searching - 使用网格进行近邻搜索
nstlist         = 10        ; Update neighbor list every 10 steps (0.01 ps) - 每10步(0.01皮秒)更新一次近邻列表
rlist           = 1.0       ; Cut-off for short-range neighbor list (nm) - 短程近邻列表的截断半径 (nm)

coulombtype     = PME       ; Particle Mesh Ewald for long-range electrostatics - PME算法处理长程静电作用
rcoulomb        = 1.0       ; Short-range electrostatic cut-off (nm) - 短程静电截断半径 (nm)

vdwtype         = Cut-off   ; Use a simple cut-off for Van der Waals interactions - 对范德华相互作用使用简单截断
rvdw            = 1.0       ; Short-range Van der Waals cut-off (nm) - 短程范德华力截断半径 (nm)
DispCorr        = EnerPres  ; Apply long-range dispersion corrections for Energy and Pressure
                              ; 对能量和压力应用长程色散校正

; Temperature coupling - 温度耦合
tcoupl          = V-rescale             ; Velocity rescaling with a stochastic term - 带随机项的速度重缩放
tc-grps         = System                ; Couple the entire system to the bath - 将整个系统耦合到热浴
tau_t           = 0.1                   ; Time constant for coupling (ps) - 耦合时间常数 (ps)
ref_t           = 300                   ; Reference temperature (K) - 参考温度 (K)

; Pressure coupling (NVT ensemble, so no pressure coupling) - 压力耦合 (NVT系综，因此无压力耦合)
pcoupl          = no        ; No pressure coupling for NVT - NVT系综不进行压力耦合

; Initial velocities - 初始速度
gen_vel         = yes       ; Generate velocities from Maxwell distribution - 从麦克斯韦分布生成速度
gen_temp        = 300       ; Temperature for Maxwell distribution (K) - 麦克斯韦分布的温度 (K)
gen_seed        = -1        ; Generate a random seed (e.g., from process ID or time) - 生成随机种子 (例如，从进程ID或时间)

; Constraints - 约束
constraints             = all-bonds ; Constrain all bonds involving H-atoms to their equilibrium length - 将所有涉及H原子的键约束在其平衡长度
constraint_algorithm    = LINCS     ; LINCS algorithm for bond constraints - LINCS约束算法
lincs_iter              = 1         ; Number of iterations for LINCS - LINCS算法的迭代次数
lincs_order             = 4         ; Order of LINCS - LINCS算法的阶数

; This is a minimal .mdp file for a short NVT simulation of a single water molecule.
; For a real system (e.g. many water molecules), you would typically have:
; 1. Energy Minimization (.mdp file)
; 2. NVT equilibration (.mdp file)
; 3. NPT equilibration (.mdp file)
; 4. Production MD run (.mdp file)
; Each step would have its own .mdp file with parameters suited for that stage.
; 这是一个用于单个水分子短时NVT模拟的最小 .mdp 文件。
; 对于真实系统 (例如许多水分子)，你通常会有：
; 1. 能量最小化 (.mdp 文件)
; 2. NVT 平衡 (.mdp 文件)
; 3. NPT 平衡 (.mdp 文件)
; 4. 生产 MD 运行 (.mdp 文件)
; 每个步骤都会有其自己针对该阶段参数调整的 .mdp 文件。
