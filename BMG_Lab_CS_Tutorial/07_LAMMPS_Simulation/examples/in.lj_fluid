# LAMMPS Input Script for a Simple Lennard-Jones Fluid Simulation
# 一个简单的 Lennard-Jones 流体模拟的 LAMMPS 输入脚本

# --- 1. Basic Setup (基本设置) ---
# This section defines fundamental simulation parameters.
# 本节定义了基本的模拟参数。
units lj                     # Use Lennard-Jones units. (使用 Lennard-Jones 单位。)
atom_style atomic            # Defines atoms as simple point particles. (将原子定义为简单的点粒子。)
dimension 3                  # Specifies a 3-dimensional simulation. (指定为三维模拟。)
boundary p p p               # Periodic boundary conditions in x, y, and z directions.
                             # 在 x, y, z 三个方向上均使用周期性边界条件。

# --- 2. System Definition (系统定义) ---
# This section sets up the simulation box and populates it with atoms.
# 本节设置模拟盒子并用原子填充它。
lattice fcc 0.8442           # Defines a face-centered cubic (FCC) lattice.
                             # The value 0.8442 is a typical reduced density for LJ systems.
                             # 定义一个面心立方 (FCC) 晶格。
                             # 值 0.8442 是 LJ 体系中一个典型的约化密度。
region sim_box block 0 10 0 10 0 10 # Defines a cubic region named 'sim_box' with side length 10 (in LJ units).
                                     # 定义一个名为 'sim_box' 的立方体区域，边长为10 (LJ单位)。
create_box 1 sim_box         # Creates a simulation box based on the 'sim_box' region for 1 atom type.
                             # 基于 'sim_box' 区域为1种原子类型创建一个模拟盒子。
create_atoms 1 box           # Fills the 'sim_box' region with atoms of type 1 according to the defined lattice.
                             # 根据定义的晶格，用类型1的原子填充 'sim_box' 区域。
mass 1 1.0                   # Assigns a mass of 1.0 (in LJ units) to atom type 1.
                             # 为原子类型1指定质量为1.0 (LJ单位)。

# --- 3. Force Field Parameters (力场参数) ---
# This section defines the interactions between atoms.
# 本节定义原子间的相互作用。
pair_style lj/cut 2.5        # Use Lennard-Jones potential with a cutoff distance of 2.5 sigma.
                             # 使用 Lennard-Jones 势，截断半径为 2.5 sigma。
pair_coeff 1 1 1.0 1.0 2.5   # Sets LJ parameters for interaction between type 1 atoms and type 1 atoms:
                             # epsilon = 1.0 (well depth - 势阱深度)
                             # sigma = 1.0 (finite distance where inter-particle potential is zero - 粒子间势能为零的有限距离)
                             # cutoff = 2.5 (as defined in pair_style - 与 pair_style 中定义的一致)
                             # 为类型1原子与类型1原子之间的相互作用设置LJ参数。

# --- 4. Settings (设置) ---
# This section configures simulation settings like initial velocities, neighbor lists, and timestep.
# 本节配置模拟设置，如初始速度、近邻列表和时间步长。
velocity all create 1.44 87287 loop geom # Assigns initial velocities to all atoms.
                                         # 'create 1.44 87287' generates velocities corresponding to temperature 1.44 (LJ units)
                                         # using random seed 87287.
                                         # 'loop geom' ensures momentum is conserved and no net translation.
                                         # 为所有原子赋予初始速度。
                                         # 'create 1.44 87287' 生成与温度1.44 (LJ单位) 对应的速度，使用随机数种子87287。
                                         # 'loop geom' 确保动量守恒且无净平动。
neighbor 0.3 bin                 # Defines the skin distance for building neighbor lists (0.3 sigma).
                                 # 'bin' is a common algorithm for neighbor list construction.
                                 # 定义构建近邻列表的蒙皮距离 (0.3 sigma)。
                                 # 'bin' 是构建近邻列表的常用算法。
neigh_modify every 20 delay 0 check yes # Parameters for neighbor list updates.
                                        # 'every 20': rebuild every 20 steps. 'delay 0': rebuild on the first possible step. 'check yes': ensure lists are built correctly.
                                        # 近邻列表更新的参数。
                                        # 'every 20': 每20步重建一次。'delay 0': 在第一个可能的步骤重建。'check yes': 确保列表正确构建。
timestep 0.005                   # Sets the integration timestep to 0.005 (in LJ time units).
                                 # This is a common value for LJ simulations.
                                 # 将积分时间步长设置为0.005 (LJ时间单位)。
                                 # 这是 LJ 模拟中的一个常用值。

# --- 5. Equilibration Run (平衡运行) ---
# This section runs the simulation for a short period to allow the system to reach equilibrium.
# 本节运行模拟一小段时间，使系统达到平衡。
fix 1 all nvt temp 1.44 1.44 0.1 # Applies an NVT ensemble (constant Number of atoms, Volume, Temperature) to all atoms.
                                 # 'temp 1.44 1.44' sets the target start and stop temperature.
                                 # '0.1' is the temperature damping parameter (in LJ time units).
                                 # Uses a Nose-Hoover thermostat.
                                 # 对所有原子应用 NVT 系综 (原子数、体积、温度恒定)。
                                 # 'temp 1.44 1.44' 设置目标起始和终止温度。
                                 # '0.1' 是温度阻尼参数 (LJ时间单位)。
                                 # 使用 Nose-Hoover 恒温器。
thermo 100                       # Prints thermodynamic information (temperature, energy, pressure, etc.) to the screen and log file every 100 steps.
                                 # 每100步将热力学信息 (温度、能量、压力等) 打印到屏幕和日志文件。
run 1000                         # Runs the simulation for 1000 timesteps.
                                 # 运行模拟1000个时间步。
unfix 1                          # Removes the NVT fix applied earlier. This is important before defining new fixes for production.
                                 # 移除之前应用的 NVT fix。这在为生产运行定义新的 fix 之前很重要。

# --- 6. Production Run (生产运行) ---
# This section runs the main simulation for data collection.
# 本节运行主模拟以收集数据。
fix 1 all nve                    # Applies an NVE ensemble (constant Number of atoms, Volume, Energy) to all atoms.
                                 # This is often used for production runs after equilibration to observe natural system dynamics.
                                 # 对所有原子应用 NVE 系综 (原子数、体积、能量恒定)。
                                 # 这通常在平衡后用于生产运行，以观察系统的自然动力学。
dump 1 all custom 100 dump.lj_fluid id type x y z # Dumps snapshots of atom properties.
                                                 # '1': dump ID. 'all': group of atoms to dump. 'custom': user-defined output.
                                                 # '100': dump every 100 timesteps. 'dump.lj_fluid': output filename.
                                                 # 'id type x y z': properties to dump.
                                                 # 转储原子属性的快照。
                                                 # '1': 转储ID。'all': 要转储的原子组。'custom': 用户定义的输出。
                                                 # '100': 每100个时间步转储一次。'dump.lj_fluid': 输出文件名。
                                                 # 'id type x y z': 要转储的属性。
thermo 100                       # Continue printing thermodynamic info. (继续打印热力学信息。)
run 5000                         # Runs the simulation for 5000 timesteps for production.
                                 # 为生产运行模拟5000个时间步。

# --- 7. Finish (结束) ---
print "Simulation finished."     # Prints a message to the screen and log file indicating completion.
                                 # 打印一条消息到屏幕和日志文件，表示模拟完成。
# 模拟结束。
